// Camera HAL1 wrapper around the stock camera.vendor.msm8974 blob.
cc_library_shared {
    name: "camera.msm8974",
    relative_install_path: "hw",
    vendor: true,
    srcs: ["CameraWrapper.cpp"],
    header_libs: ["libnativebase_headers"],
    include_dirs: ["system/media/camera/include"],
    static_libs: [
        "android.hardware.camera.common-helper",
        "libarect",
        "libbase",
    ],
    shared_libs: [
        "libcutils",
        "libdl",
        "libhardware",
        "liblog",
        "libutils",
    ],
}
